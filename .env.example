# Stratascend Analytics — environment template.
# Copy to .env (repo root, used by backend in dev) and never commit real values.

# --- Server ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stratascend

# --- Auth (JWT in HttpOnly cookie) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false        # set true in production (HTTPS)
COOKIE_SAME_SITE=lax

# --- Paystack (use test keys from https://dashboard.paystack.com/#/settings/developers) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# --- SMTP (transactional email: receipts, enrollments, contact form) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stratascend Analytics <no-reply@stratascendanalytics.com>"
CONTACT_EMAIL=hello@stratascendanalytics.com

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
